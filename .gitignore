# 忽略：外部软件与本地状态
installers/
*.exe
*.zip

# Obsidian 的本地工作区状态（每人不同，不应进仓库）
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.trash/

# 第三方插件本体（体积大且有各自许可，请从 Obsidian 社区商店安装）
.obsidian/plugins/

# 令牌（永远不会出现在仓库里）
.gh-token.txt
.gh-token.dpapi
*.dpapi

# 生成过程与临时文件
_gh_publish/
_gh_release/
_vault_test/
*.bak
*.bak[0-9]*
*.bak-*
*.log

# 本机构建产物与本地路径配置（由 tools/paths.mjs 使用）
.build/
tools/local-paths.json

